# Copy to .env in the repository root for the provider test demos.
# Use sandbox/test keys. Never put real credentials in this tracked example.
MODERN_TREASURY_ORG_ID=your-sandbox-organization-uuid
MODERN_TREASURY_API_KEY=your-sandbox-api-key
MODERN_TREASURY_INTERNAL_ACCOUNT_ID=your-sandbox-internal-account-uuid
MODERN_TREASURY_RECIPIENT_ACCOUNT_ID=your-sandbox-counterparty-external-account-uuid

# Razorpay Payments test-mode refund demo. Use a captured test payment.
RAZORPAY_TEST_KEY_ID=rzp_test_your-key-id
RAZORPAY_TEST_KEY_SECRET=your-test-key-secret
RAZORPAY_TEST_PAYMENT_ID=pay_your-captured-test-payment-id
