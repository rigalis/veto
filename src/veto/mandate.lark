// Veto mandate language. Parsing establishes shape; policy checks will
// validate values, rule conflicts, and action meaning in later checkpoints.

start: mandate

mandate: "mandate" NAME "{" rule+ "}"
rule: "rule" RULE_ID "{" clause+ "}"

?clause: cap_clause
       | merchant_clause
       | window_clause
       | precondition_clause
       | sequence_clause

cap_clause: "cap" ACTION_TYPE "<=" NUMBER CURRENCY ["per" WINDOW]
merchant_clause: MERCHANT_KIND STRING
window_clause: "valid_window" TIMESTAMP "to" TIMESTAMP
precondition_clause: "require" ACTION_TYPE "before" ACTION_TYPE
sequence_clause: "sequence" "[" ACTION_TYPE ("," ACTION_TYPE)* "]"

ACTION_TYPE.3: "payout" | "payment" | "refund" | "invoice_match"
CURRENCY.3: "INR" | "USD"
MERCHANT_KIND.3: "allow_merchant" | "deny_merchant"

NAME: /[A-Za-z_][A-Za-z0-9_]*/
RULE_ID: /[A-Za-z_][A-Za-z0-9_-]*/
NUMBER: /[0-9]+(\.[0-9]+)?/
WINDOW: /[0-9]+(\.[0-9]+)?[smhdw]/
STRING: /"(?:[^"\\]|\\.)*"/

// Require an explicit UTC offset. Calendar validity is checked later.
TIMESTAMP: /[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?([Zz]|[+-][0-9]{2}:?[0-9]{2})/

COMMENT: /#[^\n]*/ | /\/\/[^\n]*/
%ignore COMMENT
%ignore /\s+/
